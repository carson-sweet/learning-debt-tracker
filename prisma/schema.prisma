generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DebtItem {
  id           String    @id @default(cuid())
  title        String
  priority     Priority  @default(P2)
  status       Status    @default(OPEN)
  source       String?
  notes        String?
  resourceLink String?
  resolution   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  resolvedAt   DateTime?
}

enum Priority {
  P1
  P2
  P3
}

enum Status {
  OPEN
  IN_PROGRESS
  RESOLVED
}
