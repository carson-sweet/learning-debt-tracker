generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DebtItem {
  id           String    @id @default(cuid())
  title        String
  priority     String    @default("P2")
  status       String    @default("OPEN")
  source       String?
  notes        String?
  resourceLink String?
  resolution   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  resolvedAt   DateTime?
}
